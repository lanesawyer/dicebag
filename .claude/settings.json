{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo fmt --all 2>/dev/null || true",
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "cargo clippy --all 2>&1 || true",
            "statusMessage": "Linting..."
          },
        {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if [[ \"$FILE\" == *.rs ]]; then cargo test 2>&1; fi",
            "statusMessage": "Testing..."
          },
          {
            "type": "command",
            "command": "cd webapp && pnpm fmt 2>/dev/null || true",
            "statusMessage": "Formatting webapp..."
          },
          {
            "type": "command",
            "command": "cd webapp && pnpm typecheck 2>&1 || true",
            "statusMessage": "Typechecking webapp..."
          }
        ]
      }
    ]
  }
}
