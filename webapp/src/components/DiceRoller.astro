---
const dice = ["d4", "d6", "d8", "d10", "d12", "d20", "d100"];
---

<div id="dice-roller">
  <div id="dice-buttons">
    {
      dice.map((d) => (
        <button class="button is-dark is-small" data-die={d}>
          {d}
        </button>
      ))
    }
  </div>
  <div id="dice-result" aria-live="polite"></div>
</div>

<style>
  #dice-roller {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    z-index: 100;
  }
  #dice-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-end;
  }
  #dice-result {
    font-size: 2rem;
    font-weight: bold;
    text-align: center;
    min-width: 3rem;
    color: white;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }
</style>

<script>
  import init, {
    roll_d4,
    roll_d6,
    roll_d8,
    roll_d10,
    roll_d12,
    roll_d20,
    roll_d100,
  } from "../wasm/dicebag_wasm.js";

  await init();

  const rollers: Record<string, () => bigint> = {
    d4: roll_d4,
    d6: roll_d6,
    d8: roll_d8,
    d10: roll_d10,
    d12: roll_d12,
    d20: roll_d20,
    d100: roll_d100,
  };

  const result = document.getElementById("dice-result")!;

  document.getElementById("dice-buttons")!.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    if (!btn) return;
    const die = btn.dataset.die!;
    const roll = rollers[die]();
    result.textContent = String(roll);
  });
</script>
