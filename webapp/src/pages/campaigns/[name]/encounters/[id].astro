---
import Layout from "../../../../layouts/Layout.astro";
import { Box, Button, TextInput, Notification, Table } from "astro-bulma";
import { actions } from "astro:actions";
import {
  getCampaignByName,
  getEncounter,
  getPlayerRoster,
} from "../../../../lib/campaigns";

const campaignName = decodeURIComponent(Astro.params.name ?? "");
const encounterId = parseInt(Astro.params.id ?? "");
const campaign = await getCampaignByName(campaignName);
if (!campaign) return Astro.redirect("/campaigns");

const encounter = await getEncounter(campaign.id, campaignName, encounterId);
if (!encounter)
  return Astro.redirect(
    `/campaigns/${encodeURIComponent(campaignName)}/encounters`,
  );

const roster = await getPlayerRoster(campaign.id, campaignName);
const identity = await Astro.session!.get("identity");
const myPlayerId = identity?.role === "player" ? identity.playerId : null;

const addResult = Astro.getActionResult(actions.addParticipant);
const moveResult = Astro.getActionResult(actions.moveParticipant);

if (addResult && !addResult.error) {
  return Astro.redirect(
    `/campaigns/${encodeURIComponent(campaignName)}/encounters/${encounterId}`,
  );
}
if (moveResult && !moveResult.error) {
  return Astro.redirect(
    `/campaigns/${encodeURIComponent(campaignName)}/encounters/${encounterId}`,
  );
}

// Resolve participant display name from source reference
const participantName = (source: { Player?: number; Entity?: number }) => {
  if ("Player" in source) {
    return (
      roster.players.find((p) => p.id === source.Player)?.name ??
      `Player #${source.Player}`
    );
  }
  return `Entity #${source.Entity}`;
};

// Sort by initiative descending; no initiative goes to end
const ordered = [...encounter.participants].sort((a, b) => {
  if (a.initiative == null && b.initiative == null) return 0;
  if (a.initiative == null) return 1;
  if (b.initiative == null) return -1;
  return b.initiative - a.initiative;
});

// Players not yet in this encounter
const participantPlayerIds = new Set(
  encounter.participants
    .filter((p) => "Player" in p.source)
    .map((p) => (p.source as { Player: number }).Player),
);
const availablePlayers = roster.players.filter(
  (p) => !participantPlayerIds.has(p.id),
);
---

<Layout title={`${encounter.name} — ${campaign.name}`}>
  <div
    class="is-flex is-justify-content-space-between is-align-items-center mb-4"
  >
    <div>
      <h1 class="title mb-0">{encounter.name}</h1>
      <p class="subtitle mt-1">
        <a href={`/campaigns/${encodeURIComponent(campaignName)}/encounters`}
          >{campaign.name}</a
        >
      </p>
    </div>
    {
      ordered.length > 1 && (
        <form method="POST" action={actions.endTurn} id="end-turn-form">
          <input type="hidden" name="campaignId" value={campaign.id} />
          <input type="hidden" name="campaignName" value={campaignName} />
          <input type="hidden" name="encounterId" value={encounterId} />
          <button class="button is-warning" type="submit">
            End Turn
          </button>
        </form>
      )
    }
  </div>

  {
    addResult?.error && (
      <Notification color="danger">{addResult.error.message}</Notification>
    )
  }
  {
    moveResult?.error && (
      <Notification color="danger">{moveResult.error.message}</Notification>
    )
  }

  {
    ordered.length === 0 ? (
      <Notification color="info">
        No participants yet. Add players below!
      </Notification>
    ) : (
      <Table>
        <thead>
          <tr>
            <th>Order</th>
            <th>Name</th>
            <th>HP</th>
            <th />
          </tr>
        </thead>
        <tbody class="participant-list">
          {ordered.map((p, i) => (
            <tr
              class="participant-row"
              id={`participant-${p.id}`}
              data-player-id={
                "Player" in p.source
                  ? (p.source as { Player: number }).Player
                  : undefined
              }
            >
              <td>
                <div class="buttons are-small has-addons">
                  <form
                    method="POST"
                    action={actions.moveParticipant}
                    data-move
                  >
                    <input
                      type="hidden"
                      name="campaignId"
                      value={campaign.id}
                    />
                    <input
                      type="hidden"
                      name="campaignName"
                      value={campaignName}
                    />
                    <input
                      type="hidden"
                      name="encounterId"
                      value={encounterId}
                    />
                    <input type="hidden" name="participantId" value={p.id} />
                    <input type="hidden" name="direction" value="up" />
                    <button
                      class="button is-small"
                      type="submit"
                      disabled={i === 0}
                    >
                      ▲
                    </button>
                  </form>
                  <form
                    method="POST"
                    action={actions.moveParticipant}
                    data-move
                  >
                    <input
                      type="hidden"
                      name="campaignId"
                      value={campaign.id}
                    />
                    <input
                      type="hidden"
                      name="campaignName"
                      value={campaignName}
                    />
                    <input
                      type="hidden"
                      name="encounterId"
                      value={encounterId}
                    />
                    <input type="hidden" name="participantId" value={p.id} />
                    <input type="hidden" name="direction" value="down" />
                    <button
                      class="button is-small"
                      type="submit"
                      disabled={i === ordered.length - 1}
                    >
                      ▼
                    </button>
                  </form>
                </div>
              </td>
              <td>
                {participantName(p.source)}
                {"Player" in p.source &&
                  (p.source as { Player: number }).Player === myPlayerId && (
                    <span class="tag is-success is-light is-small ml-1">
                      You
                    </span>
                  )}
              </td>
              <td>
                {p.current_hp} / {p.max_hp}
              </td>
              <td>
                {ordered.length > 1 && (
                  <form method="POST" action={actions.endTurn} data-took-turn>
                    <input
                      type="hidden"
                      name="campaignId"
                      value={campaign.id}
                    />
                    <input
                      type="hidden"
                      name="campaignName"
                      value={campaignName}
                    />
                    <input
                      type="hidden"
                      name="encounterId"
                      value={encounterId}
                    />
                    <input type="hidden" name="participantId" value={p.id} />
                    <button class="button is-small is-light" type="submit">
                      Took Turn
                    </button>
                  </form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
    )
  }

  {
    availablePlayers.length > 0 && (
      <Box>
        <p class="has-text-weight-semibold mb-3">Add Player</p>
        <form method="POST" action={actions.addParticipant}>
          <input type="hidden" name="campaignId" value={campaign.id} />
          <input type="hidden" name="campaignName" value={campaignName} />
          <input type="hidden" name="encounterId" value={encounterId} />
          <div class="field">
            <label class="label">Player</label>
            <div class="control">
              <div class="select">
                <select name="playerId">
                  {availablePlayers.map((p) => (
                    <option value={p.id}>{p.name}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>
          <TextInput name="maxHp" label="Max HP" placeholder="20" />
          <Button color="primary" type="submit">
            Add to Encounter
          </Button>
        </form>
      </Box>
    )
  }
</Layout>

<style is:global>
  @keyframes row-highlight-you {
    0% {
      background-color: rgba(50, 205, 50, 0.4);
      outline: 3px solid #48c774;
      outline-offset: -2px;
    }
    100% {
      background-color: transparent;
      outline: 3px solid transparent;
      outline-offset: -2px;
    }
  }
  .row-you {
    animation: row-highlight-you 900ms ease-out forwards;
  }
</style>

<script is:inline define:vars={{ campaignName, encounterId, myPlayerId }}>
  const expected = `encounter:${campaignName}:${encounterId}`;
  const cleanUrl = location.pathname;
  window._encounterTransitioning = false;

  function flashYourRow() {
    if (myPlayerId == null) return;
    const row = document.querySelector(`[data-player-id="${myPlayerId}"]`);
    if (!row) return;
    row.classList.remove("row-you");
    void row.offsetWidth;
    row.classList.add("row-you");
    row.addEventListener(
      "animationend",
      () => row.classList.remove("row-you"),
      { once: true },
    );
  }
  window._flashYourRow = flashYourRow;

  const ws = new WebSocket(`ws://${location.hostname}:4322`);
  ws.onmessage = async (e) => {
    if (e.data !== expected) return;
    if (window._encounterTransitioning) return;
    window._encounterTransitioning = true;
    try {
      const html = await fetch(cleanUrl).then((r) => r.text());
      const doc = new DOMParser().parseFromString(html, "text/html");
      const newList = doc.querySelector(".participant-list");
      const oldList = document.querySelector(".participant-list");
      if (!newList || !oldList) {
        location.reload();
        return;
      }
      await document.startViewTransition(() => {
        oldList.replaceWith(newList);
        document.dispatchEvent(new CustomEvent("encounter:reattach"));
      }).finished;
      flashYourRow();
    } finally {
      window._encounterTransitioning = false;
    }
  };
</script>

<script>
  function updateDisabled() {
    const list = document.querySelector(".participant-list");
    if (!list) return;
    const rows = [...list.querySelectorAll(".participant-row")];
    rows.forEach((row, i) => {
      const forms = row.querySelectorAll<HTMLFormElement>("form[data-move]");
      const upBtn = forms[0]?.querySelector("button");
      const downBtn = forms[1]?.querySelector("button");
      if (upBtn) upBtn.disabled = i === 0;
      if (downBtn) downBtn.disabled = i === rows.length - 1;
    });
  }

  async function sendToBottom(form: HTMLFormElement, rowEl: HTMLElement) {
    const list = document.querySelector(".participant-list");
    if (!list) return;
    fetch(form.action, { method: "POST", body: new FormData(form) });
    (window as any)._encounterTransitioning = true;
    const t = document.startViewTransition(() => {
      list.appendChild(rowEl);
      updateDisabled();
    });
    await t.finished;
    (window as any)._encounterTransitioning = false;
    (window as any)._flashYourRow?.();
  }

  function attachEndTurnHandler() {
    const form = document.getElementById(
      "end-turn-form",
    ) as HTMLFormElement | null;
    if (!form) return;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const list = document.querySelector(".participant-list");
      if (!list) return;
      const rows = [...list.querySelectorAll(".participant-row")];
      if (rows.length < 2) return;
      await sendToBottom(form, rows[0] as HTMLElement);
    });
  }

  function attachTookTurnHandlers() {
    document.querySelectorAll("form[data-took-turn]").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const rowEl = form.closest(".participant-row") as HTMLElement | null;
        if (!rowEl) return;
        await sendToBottom(form as HTMLFormElement, rowEl);
      });
    });
  }

  function attachMoveHandlers() {
    updateDisabled();
    attachEndTurnHandler();
    attachTookTurnHandlers();
    document.querySelectorAll("form[data-move]").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const f = form as HTMLFormElement;
        const direction = (
          f.querySelector("[name=direction]") as HTMLInputElement
        ).value;
        const rowEl = f.closest(".participant-row") as HTMLElement | null;
        const list = document.querySelector(".participant-list");
        if (!rowEl || !list) return;

        // Find the sibling to swap with
        const rows = [...list.querySelectorAll(".participant-row")];
        const idx = rows.indexOf(rowEl);
        const swapIdx = direction === "up" ? idx - 1 : idx + 1;
        if (swapIdx < 0 || swapIdx >= rows.length) return;
        const swapEl = rows[swapIdx] as HTMLElement;

        fetch(f.action, { method: "POST", body: new FormData(f) });

        (window as any)._encounterTransitioning = true;
        const t = document.startViewTransition(() => {
          if (direction === "up") {
            list.insertBefore(rowEl, swapEl);
          } else {
            list.insertBefore(swapEl, rowEl);
          }
          updateDisabled();
        });
        await t.finished;
        (window as any)._encounterTransitioning = false;
        (window as any)._flashYourRow?.();
      });
    });
  }

  document.addEventListener("astro:page-load", attachMoveHandlers);
  document.addEventListener("encounter:reattach", attachMoveHandlers);
</script>
