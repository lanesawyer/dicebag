{
  "name": "dicebag",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm": "wasm-pack build ../wasm --target web --out-dir ../webapp/src/wasm",
    "dev": "pnpm run wasm && astro dev --host",
    "build": "pnpm run wasm && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/node": "10.0.4",
    "astro": "6.4.6",
    "astro-bulma": "github:lanesawyer/astro-bulma",
    "bulma": "1.0.4",
    "ws": "8.20.0"
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "@types/ws": "8.18.1",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.2"
  }
}
